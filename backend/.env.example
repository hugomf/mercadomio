# Server Configuration
PORT=8080

# Static images directory (relative to repo root or absolute)
IMAGES_PATH=./frontend/web/assets/images

# OIDC / userbrew (replaces local JWT auth)
USERBREW_ISSUER=http://localhost:8090
USERBREW_DISCOVERY_URL=http://localhost:8090/.well-known/openid-configuration
USERBREW_AUDIENCES=mercadomio-storefront,mercadomio-admin

# Database Configuration
MONGO_URI=mongodb://localhost:27017/mercadomio

# Redis Configuration
REDIS_ADDR=localhost:6379

# imgvault image service (secure proxy for product images)
IMGVAULT_URL=http://localhost:8081
IMGVAULT_API_KEY="REDACTED"

# Legacy JWT (kept for backward compatibility during migration)
JWT_SECRET=your-jwt-secret-here-change-in-production

# Conekta Payment Configuration (demo mode: leave keys empty → simulate-success path)
CONEKTA_SECRET_KEY=your-conekta-private-key
CONEKTA_PUBLIC_KEY=your-conekta-public-key
CONEKTA_WEBHOOK_PUBLIC_KEY_PEM=your-conekta-webhook-public-key-pem
CONEKTA_SUCCESS_URL=http://localhost:8080/payments/confirmation
CONEKTA_FAILURE_URL=http://localhost:8080/payments/failure

# Database Configuration
DATABASE_URL=your-database-url
