# --- App server ---
APP_HOST=sonnora-prod
VPS_HOST=sonnora
DOMAIN=mercadomio.sonnora.mx
APP_HOST_IP=192.168.1.90
APP_DIR=/opt/mercadomio
WEB_ROOT=/var/www/mercadomio

# --- Registry ---
REGISTRY_IMAGE_TAG=prod

# --- App / service ports ---
BACKEND_PORT=8083
FRONTEND_PORT=8084
ADMIN_PORT=8085
DIRECTUS_PORT=8055
IMGVAULT_PORT=8081
MINIO_PORT=9000

# --- Backend ---
USERBREW_ISSUER=https://userbrew.sonnora.mx
USERBREW_DISCOVERY_URL=https://userbrew.sonnora.mx/.well-known/openid-configuration
MONGO_URI=mongodb://mongo:27017/mercadomio
REDIS_ADDR=redis:6379
REDIS_URI=redis://redis:6379
DIRECTUS_URL=http://127.0.0.1:8055
IMGVAULT_URL=http://127.0.0.1:8081
CORS_ORIGINS=https://mercadomio.sonnora.mx
