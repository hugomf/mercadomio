# --- App server ---
APP_HOST=sonnora-qa
VPS_HOST=sonnora
DOMAIN=mercadomio.qa.sonnora.mx
APP_HOST_IP=10.0.0.4
APP_DIR=/opt/mercadomio
WEB_ROOT=/var/www/mercadomio

# --- Registry ---
REGISTRY_IMAGE_TAG=qa

# --- App / service ports ---
# App ports (backend/frontend/admin) exposed via app-nginx on the host.
BACKEND_PORT=8083
FRONTEND_PORT=8084
ADMIN_PORT=8085
APP_NGINX_PORT=28080
# -- Infra host ports (dedicated mercadomio range; shared Pi has many taken) --
DIRECTUS_PORT=8055
IMGVAULT_PORT=28081
MINIO_PORT=29000
MINIO_CONSOLE_PORT=29001
POSTGRES_PORT=25432
MONGO_PORT=27018
REDIS_PORT=26379

# --- Backend ---
USERBREW_ISSUER=https://userbrew.qa.sonnora.mx
USERBREW_DISCOVERY_URL=https://userbrew.qa.sonnora.mx/.well-known/openid-configuration
MONGO_URI=mongodb://mongo:27017/mercadomio
REDIS_ADDR=redis:6379
REDIS_URI=redis://redis:6379
# Directus/imgvault reached by service name over mercadomio-net (internal), so
# host port collisions don't affect the app.
DIRECTUS_URL=http://directus:8055
IMGVAULT_URL=http://imgvault:8081
IMGVAULT_API_KEY=dev_api_key_123
CORS_ORIGINS=https://mercadomio.qa.sonnora.mx
