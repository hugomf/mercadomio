# Secrets for the local userbrew sidecar (gitignored).
# Copy docker/.env.local.example to docker/.env.local and edit.
# Use random 32+ byte values:  openssl rand -hex 32
JWT_SECRET=
PEPPER=
TOKEN_SECRET=
USERBREW_ADMIN_EMAIL=admin@mercadomio.mx
USERBREW_ADMIN_USERNAME=mercadomio-admin
USERBREW_ADMIN_PASSWORD=
# Use the locally built image when the registry image lacks the latest engine.
# Build it with:  cd ~/Projects/userbrew && ./scripts/docker-build.sh
# USERBREW_IMAGE=userbrew:latest