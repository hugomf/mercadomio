# Secrets for the local userbrew sidecar (gitignored).
# Copy docker/.env.local.example to docker/.env.local and edit.
# Use random 32+ byte values:  openssl rand -hex 32
JWT_SECRET=
PEPPER=
TOKEN_SECRET=
# Admin credentials for userbrew. The platform bootstrap (sonnora-deploy/platform/bootstrap.sh)
# creates a provisioner user and stores the JWT at /tmp/platform-provisioning-user.token.
# If USERBREW_ADMIN_TOKEN is not set, this script reads the provisioner token automatically.
# USERBREW_ADMIN_TOKEN=ub_sk_...
# # Or fallback to username/password:
# USERBREW_ADMIN_EMAIL=admin@mercadomio.mx
# USERBREW_ADMIN_USERNAME=mercadomio-admin
# USERBREW_ADMIN_PASSWORD=